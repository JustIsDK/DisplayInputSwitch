<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>DisplayInputSwitch</AssemblyName>
    <ApplicationIcon>../Assets/AppIcon.ico</ApplicationIcon>
    <Version>2.12.0</Version>
  </PropertyGroup>
  <ItemGroup><EmbeddedResource Include="../Shared/default.json" Link="default.json" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../Assets/AppIcon.ico" LogicalName="DisplayInputSwitch.AppIcon.ico" /></ItemGroup>
  <ItemGroup><None Include="../vendor/MonitorControl/LICENSE" Link="MonitorControl-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
</Project>
